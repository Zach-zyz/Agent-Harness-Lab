# Ubuntu 24.04 administrator prerequisite for the system Bubblewrap executable.
# This allows creation of user namespaces; the HW2 sandbox still supplies its
# filesystem, network, process and resource restrictions.
abi <abi/4.0>,
include <tunables/global>
profile cse8803-bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,
}
